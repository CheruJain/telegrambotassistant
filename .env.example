# Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_USER_ID=your_numeric_telegram_user_id_here

# AI (Anthropic Claude)
AI_API_KEY=your_anthropic_api_key_here
AI_MODEL=gemini-2.5-flash

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_service_role_or_anon_key_here

# WhatsApp Business Cloud API
WHATSAPP_ENABLED=false
WHATSAPP_ACCESS_TOKEN=your_whatsapp_access_token_here
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id_here
WHATSAPP_GRAPH_API_VERSION=v23.0
WHATSAPP_TEMPLATE_LANGUAGE=en_US

# App config (can also be changed later via /config command, stored in DB)
DEFAULT_TIMEZONE=Asia/Kolkata
USER_NAME=Your Name
WEEKLY_REPORT_DAY=sun
WEEKLY_REPORT_HOUR=19
WEEKLY_REPORT_MINUTE=0
DEFAULT_MEETING_REMINDER_MINUTES=30
SCHEDULER_POLL_SECONDS=30
